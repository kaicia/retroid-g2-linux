/*
 * Retroid Pocket G2 (Cliffs) interconnect providers — minimum subset.
 *
 * The physical G2 Android DT resolves the four SDCC2 interconnect endpoints
 * to these Cliffs NoC providers (compatible strings and addresses captured
 * directly from the device; see
 * dumps/g2/g2-sdhci-interconnect-opp-resolution-20260821-061758.txt):
 *
 *   interconnect@16E0000  qcom,cliffs-aggre1_noc  -> MASTER_SDCC_2 (47)
 *   interconnect@1        qcom,cliffs-mc_virt     -> SLAVE_EBI1    (512)
 *   interconnect@24100000 qcom,cliffs-gem_noc     -> MASTER_APPSS_PROC (2)
 *   interconnect@1600000  qcom,cliffs-cnoc_cfg    -> SLAVE_SDCC_2  (542)
 *
 * These NoCs occupy the same register addresses as the SM7635/Milos NoCs in
 * the upstream Linux tree at the pinned revision, so this fragment overrides
 * only the compatible strings (label-to-label). The underlying reg/clocks/
 * bcm-voter scaffolding remains the upstream Milos scaffolding and is NOT
 * asserted here as G2-verified.
 *
 * UNRESOLVED (do not guess): per-NoC `qcom,bcm-voters`/clock wiring and any
 * additional Cliffs endpoints beyond the four SDCC2 endpoints listed above.
 * The physical G2 NoCs also use `#interconnect-cells = <1>` (flat endpoint,
 * no path tag); the upstream Linux rpmh interconnect driver uses the
 * `#interconnect-cells = <2>` extended form (endpoint + QCOM_ICC_TAG_*), so
 * this fragment keeps the upstream <2> convention for an
 * upstream-Linux-7.1.5-compatible provider.
 */

&aggre1_noc {
	compatible = "qcom,cliffs-aggre1_noc";
};

&mc_virt {
	compatible = "qcom,cliffs-mc_virt";
};

&gem_noc {
	compatible = "qcom,cliffs-gem_noc";
};

&cnoc_cfg {
	compatible = "qcom,cliffs-cnoc_cfg";
};
