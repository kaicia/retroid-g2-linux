/*
 * Retroid Pocket G2 (Snapdragon G2 Gen 2 / Cliffs) interconnect providers —
 * minimum subset.
 *
 * The physical G2 Android DT resolves the four SDCC2 interconnect endpoints
 * to these Cliffs NoC providers (compatibles captured from the device under
 * dumps/g2/g2-sdhci-phandle-resolution-20260821-061126.txt):
 *
 *   qcom,cliffs-aggre1_noc  (interconnect@16e0000)  -> MASTER_SDCC_2 (47)
 *   qcom,cliffs-mc_virt     (interconnect@1)        -> SLAVE_EBI1    (512)
 *   qcom,cliffs-gem_noc     (interconnect@24100000) -> MASTER_APPSS_PROC (2)
 *   qcom,cliffs-cnoc_cfg    (interconnect@1600000)  -> SLAVE_SDCC_2  (542)
 *
 * These NoCs occupy the same register addresses as the SM7635/Milos NoCs in
 * the upstream Linux tree, so this fragment overrides only the compatible
 * strings (the minimum provider change needed by the G2 SDCC2 node). The
 * underlying reg/clocks/bcm-voter properties remain the upstream Milos
 * scaffolding and are NOT asserted here as G2-verified.
 *
 * Note: the physical G2 vendor binding uses #interconnect-cells = <1> (flat
 * endpoint namespace); the upstream Milos NoC scaffolding uses
 * #interconnect-cells = <2> (endpoint + QCOM_ICC_TAG_*). This compile
 * candidate keeps the upstream 2-cell form so the mainline interconnect
 * framework parses it, and records the 1-cell difference as UNRESOLVED.
 *
 * UNRESOLVED (do not guess): per-NoC `qcom,bcm-voters`/clock wiring and any
 * additional Cliffs endpoints beyond the four SDCC2 endpoints listed above.
 */

&aggre1_noc {
	compatible = "qcom,cliffs-aggre1_noc";
};

&mc_virt {
	compatible = "qcom,cliffs-mc_virt";
};

&gem_noc {
	compatible = "qcom,cliffs-gem_noc";
};

&cnoc_cfg {
	compatible = "qcom,cliffs-cnoc_cfg";
};
